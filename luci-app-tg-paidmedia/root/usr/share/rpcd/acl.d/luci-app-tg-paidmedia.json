{
  "luci-app-tg-paidmedia": {
    "description": "Grant access to Telegram Paid Media service configuration",
    "read": {
      "ubus": {
        "file": [
          "exec"
        ],
        "luci": [
          "getInitList"
        ],
        "service": [
          "list"
        ]
      },
      "uci": [
        "tg-paidmedia"
      ],
      "file": {
        "/etc/tg-paidmedia": [
          "list"
        ],
        "/etc/tg-paidmedia/*": [
          "read"
        ],
        "/bin/cat /var/run/tg-paidmedia/status.json": [
          "exec"
        ],
        "/sbin/logread -l 200": [
          "exec"
        ]
      }
    },
    "write": {
      "ubus": {
        "file": [
          "exec"
        ],
        "luci": [
          "setInitAction"
        ]
      },
      "uci": [
        "tg-paidmedia"
      ],
      "file": {
        "/etc/tg-paidmedia": [
          "write"
        ],
        "/etc/tg-paidmedia/*": [
          "write",
          "remove"
        ],
        "/sbin/uci set tg-paidmedia.main.yoomoney_tunnel_enabled=0": [
          "exec"
        ],
        "/sbin/uci set tg-paidmedia.main.yoomoney_tunnel_enabled=1": [
          "exec"
        ],
        "/sbin/uci commit tg-paidmedia": [
          "exec"
        ],
        "/etc/init.d/log restart": [
          "exec"
        ]
      }
    }
  }
}
