#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/python3
SCRIPT=/usr/libexec/tg-paidmedia/bot.py
TUNNEL_SCRIPT=/usr/libexec/tg-paidmedia/yoomoney-tunnel.sh
CONFIG=tg-paidmedia
SECTION=main

. /lib/functions.sh

start_service() {
	local enabled token bot_title welcome_text data_dir catalog_path
	local state_path status_path poll_timeout drop_pending admin_ids
	local platega_enabled platega_base_url platega_merchant_id platega_secret_key
	local platega_callback_url platega_success_url platega_fail_url platega_redirect_url
	local platega_webhook_host platega_webhook_port platega_webhook_path
	local platega_status_poll_interval platega_status_timeout platega_http_timeout
	local yoomoney_enabled yoomoney_wallet yoomoney_notification_secret
	local yoomoney_callback_url yoomoney_success_url yoomoney_webhook_host
	local yoomoney_webhook_port yoomoney_webhook_path yoomoney_payment_path
	local yoomoney_tunnel_enabled yoomoney_tunnel_host yoomoney_tunnel_port
	local yoomoney_tunnel_user yoomoney_tunnel_remote_port
	local yoomoney_tunnel_local_host yoomoney_tunnel_local_port
	local yoomoney_tunnel_private_key yoomoney_tunnel_accept_hostkey

	config_load "$CONFIG"
	config_get_bool enabled "$SECTION" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get token "$SECTION" token
	[ -n "$token" ] || {
		echo "tg-paidmedia: missing bot token" >&2
		return 1
	}

	config_get bot_title "$SECTION" bot_title "Магазин платного контента"
	config_get welcome_text "$SECTION" welcome_text "Выберите товар ниже, и Telegram покажет официальное окно подтверждения покупки за Stars."
	config_get data_dir "$SECTION" data_dir "/var/lib/tg-paidmedia"
	config_get catalog_path "$SECTION" catalog_path "/etc/tg-paidmedia/catalog.json"
	config_get state_path "$SECTION" state_path "/var/lib/tg-paidmedia/state.json"
	config_get status_path "$SECTION" status_path "/var/run/tg-paidmedia/status.json"
	config_get poll_timeout "$SECTION" poll_timeout "25"
	config_get_bool drop_pending "$SECTION" drop_pending 1
	config_get_bool platega_enabled "$SECTION" platega_enabled 0
	config_get platega_base_url "$SECTION" platega_base_url "https://app.platega.io"
	config_get platega_merchant_id "$SECTION" platega_merchant_id ""
	config_get platega_secret_key "$SECTION" platega_secret_key ""
	config_get platega_callback_url "$SECTION" platega_callback_url ""
	config_get platega_success_url "$SECTION" platega_success_url ""
	config_get platega_fail_url "$SECTION" platega_fail_url ""
	config_get platega_redirect_url "$SECTION" platega_redirect_url ""
	config_get platega_webhook_host "$SECTION" platega_webhook_host "0.0.0.0"
	config_get platega_webhook_port "$SECTION" platega_webhook_port "8099"
	config_get platega_webhook_path "$SECTION" platega_webhook_path "/platega/webhook"
	config_get platega_status_poll_interval "$SECTION" platega_status_poll_interval "20"
	config_get platega_status_timeout "$SECTION" platega_status_timeout "900"
	config_get platega_http_timeout "$SECTION" platega_http_timeout "25"
	config_get_bool yoomoney_enabled "$SECTION" yoomoney_enabled 0
	config_get yoomoney_wallet "$SECTION" yoomoney_wallet ""
	config_get yoomoney_notification_secret "$SECTION" yoomoney_notification_secret ""
	config_get yoomoney_callback_url "$SECTION" yoomoney_callback_url ""
	config_get yoomoney_success_url "$SECTION" yoomoney_success_url ""
	config_get yoomoney_webhook_host "$SECTION" yoomoney_webhook_host "0.0.0.0"
	config_get yoomoney_webhook_port "$SECTION" yoomoney_webhook_port "8100"
	config_get yoomoney_webhook_path "$SECTION" yoomoney_webhook_path "/yoomoney/webhook"
	config_get yoomoney_payment_path "$SECTION" yoomoney_payment_path "/yoomoney/pay"
	config_get_bool yoomoney_tunnel_enabled "$SECTION" yoomoney_tunnel_enabled 0
	config_get yoomoney_tunnel_host "$SECTION" yoomoney_tunnel_host ""
	config_get yoomoney_tunnel_port "$SECTION" yoomoney_tunnel_port "22"
	config_get yoomoney_tunnel_user "$SECTION" yoomoney_tunnel_user "root"
	config_get yoomoney_tunnel_remote_port "$SECTION" yoomoney_tunnel_remote_port "18101"
	config_get yoomoney_tunnel_local_host "$SECTION" yoomoney_tunnel_local_host "127.0.0.1"
	config_get yoomoney_tunnel_local_port "$SECTION" yoomoney_tunnel_local_port "$yoomoney_webhook_port"
	config_get yoomoney_tunnel_private_key "$SECTION" yoomoney_tunnel_private_key "/root/.ssh/id_ed25519"
	config_get_bool yoomoney_tunnel_accept_hostkey "$SECTION" yoomoney_tunnel_accept_hostkey 1
	TG_ADMIN_IDS=""
	config_list_foreach "$SECTION" admin_ids append_admin_id

	mkdir -p "$data_dir" "$(dirname "$catalog_path")" "$(dirname "$state_path")" "$(dirname "$status_path")"

	procd_open_instance
	procd_set_param command "$PROG" "$SCRIPT"
	procd_set_param env TG_BOT_TOKEN="$token"
	procd_append_param env TG_BOT_TITLE="$bot_title"
	procd_append_param env TG_WELCOME_TEXT="$welcome_text"
	procd_append_param env TG_DATA_DIR="$data_dir"
	procd_append_param env TG_CATALOG_PATH="$catalog_path"
	procd_append_param env TG_STATE_PATH="$state_path"
	procd_append_param env TG_STATUS_PATH="$status_path"
	procd_append_param env TG_POLL_TIMEOUT="$poll_timeout"
	procd_append_param env TG_DROP_PENDING="$drop_pending"
	procd_append_param env TG_ADMIN_IDS="$TG_ADMIN_IDS"
	procd_append_param env TG_PLATEGA_ENABLED="$platega_enabled"
	procd_append_param env TG_PLATEGA_BASE_URL="$platega_base_url"
	procd_append_param env TG_PLATEGA_MERCHANT_ID="$platega_merchant_id"
	procd_append_param env TG_PLATEGA_SECRET_KEY="$platega_secret_key"
	procd_append_param env TG_PLATEGA_CALLBACK_URL="$platega_callback_url"
	procd_append_param env TG_PLATEGA_SUCCESS_URL="$platega_success_url"
	procd_append_param env TG_PLATEGA_FAIL_URL="$platega_fail_url"
	procd_append_param env TG_PLATEGA_REDIRECT_URL="$platega_redirect_url"
	procd_append_param env TG_PLATEGA_WEBHOOK_HOST="$platega_webhook_host"
	procd_append_param env TG_PLATEGA_WEBHOOK_PORT="$platega_webhook_port"
	procd_append_param env TG_PLATEGA_WEBHOOK_PATH="$platega_webhook_path"
	procd_append_param env TG_PLATEGA_STATUS_POLL_INTERVAL="$platega_status_poll_interval"
	procd_append_param env TG_PLATEGA_STATUS_TIMEOUT="$platega_status_timeout"
	procd_append_param env TG_PLATEGA_HTTP_TIMEOUT="$platega_http_timeout"
	procd_append_param env TG_YOOMONEY_ENABLED="$yoomoney_enabled"
	procd_append_param env TG_YOOMONEY_WALLET="$yoomoney_wallet"
	procd_append_param env TG_YOOMONEY_NOTIFICATION_SECRET="$yoomoney_notification_secret"
	procd_append_param env TG_YOOMONEY_CALLBACK_URL="$yoomoney_callback_url"
	procd_append_param env TG_YOOMONEY_SUCCESS_URL="$yoomoney_success_url"
	procd_append_param env TG_YOOMONEY_WEBHOOK_HOST="$yoomoney_webhook_host"
	procd_append_param env TG_YOOMONEY_WEBHOOK_PORT="$yoomoney_webhook_port"
	procd_append_param env TG_YOOMONEY_WEBHOOK_PATH="$yoomoney_webhook_path"
	procd_append_param env TG_YOOMONEY_PAYMENT_PATH="$yoomoney_payment_path"
	procd_append_param env TG_YOOMONEY_TUNNEL_ENABLED="$yoomoney_tunnel_enabled"
	procd_append_param env TG_YOOMONEY_TUNNEL_HOST="$yoomoney_tunnel_host"
	procd_append_param env TG_YOOMONEY_TUNNEL_PORT="$yoomoney_tunnel_port"
	procd_append_param env TG_YOOMONEY_TUNNEL_USER="$yoomoney_tunnel_user"
	procd_append_param env TG_YOOMONEY_TUNNEL_REMOTE_PORT="$yoomoney_tunnel_remote_port"
	procd_append_param env TG_YOOMONEY_TUNNEL_LOCAL_HOST="$yoomoney_tunnel_local_host"
	procd_append_param env TG_YOOMONEY_TUNNEL_LOCAL_PORT="$yoomoney_tunnel_local_port"
	procd_append_param env TG_YOOMONEY_TUNNEL_PRIVATE_KEY="$yoomoney_tunnel_private_key"
	procd_append_param env TG_YOOMONEY_TUNNEL_ACCEPT_HOSTKEY="$yoomoney_tunnel_accept_hostkey"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ "$yoomoney_tunnel_enabled" -eq 1 ]; then
		procd_open_instance yoomoney-tunnel
		procd_set_param command /bin/sh "$TUNNEL_SCRIPT"
		procd_set_param env TG_YOOMONEY_TUNNEL_HOST="$yoomoney_tunnel_host"
		procd_append_param env TG_YOOMONEY_TUNNEL_PORT="$yoomoney_tunnel_port"
		procd_append_param env TG_YOOMONEY_TUNNEL_USER="$yoomoney_tunnel_user"
		procd_append_param env TG_YOOMONEY_TUNNEL_REMOTE_PORT="$yoomoney_tunnel_remote_port"
		procd_append_param env TG_YOOMONEY_TUNNEL_LOCAL_HOST="$yoomoney_tunnel_local_host"
		procd_append_param env TG_YOOMONEY_TUNNEL_LOCAL_PORT="$yoomoney_tunnel_local_port"
		procd_append_param env TG_YOOMONEY_TUNNEL_PRIVATE_KEY="$yoomoney_tunnel_private_key"
		procd_append_param env TG_YOOMONEY_TUNNEL_ACCEPT_HOSTKEY="$yoomoney_tunnel_accept_hostkey"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

append_admin_id() {
	local value="$1"

	[ -n "$value" ] || return 0

	if [ -n "$TG_ADMIN_IDS" ]; then
		TG_ADMIN_IDS="$TG_ADMIN_IDS,$value"
	else
		TG_ADMIN_IDS="$value"
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
