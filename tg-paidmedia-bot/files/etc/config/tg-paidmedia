config bot 'main'
	option enabled '0'
	option token ''
	# list admin_ids '123456789'
	option bot_title 'Магазин платного контента'
	option welcome_text 'Откройте каталог внизу, в Telegram магазине эксклюзивного платного контента за Stars.'
	option home_image 'https://raw.githubusercontent.com/kzolotarev95/luci-app-tg-paidmedia/main/assets/bot-home-header.jpg'
	option data_dir '/var/lib/tg-paidmedia'
	option catalog_path '/etc/tg-paidmedia/catalog.json'
	option state_path '/var/lib/tg-paidmedia/state.json'
	option status_path '/var/run/tg-paidmedia/status.json'
	option poll_timeout '25'
	option drop_pending '1'
	option platega_enabled '0'
	option platega_base_url 'https://app.platega.io'
	option platega_merchant_id ''
	option platega_secret_key ''
	option platega_callback_url ''
	option platega_success_url ''
	option platega_fail_url ''
	option platega_redirect_url ''
	option platega_webhook_host '0.0.0.0'
	option platega_webhook_port '8099'
	option platega_webhook_path '/platega/webhook'
	option platega_status_poll_interval '20'
	option platega_status_timeout '900'
	option platega_http_timeout '25'
	option yoomoney_enabled '0'
	option yoomoney_wallet ''
	option yoomoney_notification_secret ''
	option yoomoney_callback_url ''
	option yoomoney_success_url ''
	option yoomoney_webhook_host '0.0.0.0'
	option yoomoney_webhook_port '8100'
	option yoomoney_webhook_path '/yoomoney/webhook'
	option yoomoney_payment_path '/yoomoney/pay'
	option yoomoney_tunnel_enabled '0'
	option yoomoney_tunnel_host ''
	option yoomoney_tunnel_port '22'
	option yoomoney_tunnel_user 'root'
	option yoomoney_tunnel_remote_port '18101'
	option yoomoney_tunnel_local_host '127.0.0.1'
	option yoomoney_tunnel_local_port '8100'
	option yoomoney_tunnel_private_key '/root/.ssh/id_ed25519'
	option yoomoney_tunnel_accept_hostkey '1'
